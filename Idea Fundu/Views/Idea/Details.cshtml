@model Idea

@{
    ViewBag.Title = "Idea Details";
}

<div class="container mt-5">

    <div class="row">

        @* LEFT SECTION *@

        <div class="col-md-8">

            <div class="card border-0 shadow rounded-4 mb-4">

                <div class="card-body p-5">

                    <span class="badge bg-primary mb-3">
                        @Model.Category
                    </span>

                    <h1 class="fw-bold mb-4">
                        @Model.Title
                    </h1>

                    <p class="text-muted fs-5">
                        @Model.Description
                    </p>

                </div>

            </div>

            @* RISK SECTION *@

            <div class="card border-0 shadow rounded-4 mb-4">

                <div class="card-body p-4">

                    <h3 class="fw-bold mb-3">
                        Risk Analysis
                    </h3>

                    <p>
                        @(Model.RiskLevel ?? "No risk analysis available.")
                    </p>

                </div>

            </div>

            @* RESTRICTIONS *@

            <div class="card border-0 shadow rounded-4 mb-4">

                <div class="card-body p-4">

                    <h3 class="fw-bold mb-3">
                        Investment Restrictions
                    </h3>

                    <p>
                        @(Model.Restrictions ?? "No restrictions added.")
                    </p>

                </div>

            </div>

            @* STARTUP UPDATES SECTION *@

            <div class="card border-0 shadow rounded-4">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <h3 class="fw-bold">

                            Startup Updates

                        </h3>

                        <a asp-action="Create"
                           asp-controller="StartupUpdate"
                        asp-route-ideaId="@Model.Id"
                        class="btn btn-outline-success">

                            Add Update

                        </a>

                    </div>

                    @if(ViewBag.Updates.Count > 0)
                    {
                        @foreach(var item in ViewBag.Updates)
                        {
                            <div class="border rounded-4 p-3 mb-3">

                                <h5 class="fw-bold">
                                    @item.Title
                                </h5>

                                <p>
                                    @item.Description
                                </p>

                                <small class="text-muted">

                                    Posted On:
                                    @item.CreatedDate.ToShortDateString()

                                </small>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info">

                            No startup updates available.

                        </div>
                    }
                </div>

            </div>

        </div>

        @* RIGHT SECTION *@

        <div class="col-md-4">

            <div class="card border-0 shadow rounded-4 sticky-top">

                <div class="card-body p-4">

                    <h3 class="fw-bold text-success">
                        ₹ @Model.RequiredFund.ToString("N0")
                    </h3>

                    <p class="text-muted">
                        Funding Goal
                    </p>

                    <p class="text-muted">
                        Posted on @Model.CreatedDate.ToShortDateString()
                    </p>

                    <hr />

                    <div class="mb-4">

                        <h5 class="text-success fw-bold">
                            ₹ @ViewBag.TotalInvestment.ToString("N0")
                        </h5>

                        <p class="text-muted">
                            Total Investment Raised
                        </p>

                    </div>

                    <div class="mb-3">

                        <label class="fw-bold">

                            Funding Progress

                        </label>

                        <div class="progress mt-2" style="height:25px">

                            <div class="progress-bar bg-success" style="width:@ViewBag.Progress%">
                                @Math.Round(ViewBag.Progress, 0)%
                            </div>

                        </div>

                    </div>

                    <div class="mt-3">

                        <p>
                            <strong>Remaing Amount:</strong>
                            ₹ @ViewBag.RemainingAmount.ToString("N0")
                        </p>

                    </div>

                    <a asp-action="Create" asp-controller="Investment" asp-route-ideaId="@Model.Id" class="btn btn-success w-100 btn-lg">

                       Invest Now

                   </a>

                    <a asp-action="Index"
                       class="btn btn-outline-dark w-100 mt-2">

                        Back to Ideas

                    </a>

                </div>

            </div>


        </div>

    </div>

</div>