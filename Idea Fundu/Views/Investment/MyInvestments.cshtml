@model IEnumerable<Investment>

@{
    ViewBag.Title = "My Investments";
}

<div class="container mt-5">

    <div class="d-flex justify-content-center align-content-center mb-4">

        <h2 class="fw-bold">
            My Investments
        </h2>
        </div>
        @if (Model.Any())
        {
            <div class="row">

                @foreach(var item in Model)
                {
                    <div class="col-md-6 mb-4">

                        <div class="card rounded-4 shadow border-0 h-100">

                            <div class="card-body p-4">

                                <span class="badge bg-success mb-2">

                                    ₹ @item.Amount.ToString("N0")

                                </span>

                                <h4 class="fw-bold">
                                    @item.Idea.Title
                                </h4>

                                <p class="text-muted">
                                    @item.Idea.Category
                                </p>

                                <p>
                                    
                                @(item.Suggestions ?? "No suggestions added.")
                                </p>

                                <p class="text-muted">

                                    Invested On:
                                    @item.InvestmentDate.ToShortDateString()

                                </p>

                                <a asp-action="Details"
                                asp-controller="Idea"
                                asp-route-id="@item.IdeaId"
                                class="btn btn-outline-primary">

                                View Idea
                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="alert alert-info rounded-4">

                You have not invested in any ideas yet.

            </div>
        }

    </div>

