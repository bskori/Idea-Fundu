@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
}

<div class="container py-4 py-md-5">

    <div class="row justify-content-center align-items-center min-vh-75">

        <div class="col-12 col-sm-10 col-md-8 col-lg-6">

            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

                <div class="bg-dark text-white text-center p-4 p-md-5">

                    <h2 class="fw-bold mb-2">

                        Create Account

                    </h2>

                    <p class="mb-0 text-light">

                        Join Idea Fundu today

                    </p>

                </div>

                <div class="card-body p-4 p-md-5">

                    <form id="registerForm"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger rounded-3 mb-4">
                        </div>

                        <div class="form-floating mb-4">

                            <input asp-for="Input.FullName"
                                   class="form-control"
                                   placeholder="Full Name" />

                            <label asp-for="Input.FullName"></label>

                            <span asp-validation-for="Input.FullName"
                                  class="text-danger small"></span>

                        </div>

                        <div class="form-floating mb-4">

                            <input asp-for="Input.Email"
                                   class="form-control"
                                   placeholder="Email Address" />

                            <label asp-for="Input.Email"></label>

                            <span asp-validation-for="Input.Email"
                                  class="text-danger small"></span>

                        </div>

                        <div class="row">

                            <div class="col-12 col-md-6">

                                <div class="form-floating mb-4">

                                    <input asp-for="Input.Password"
                                           class="form-control"
                                           placeholder="Password" />

                                    <label asp-for="Input.Password"></label>

                                    <span asp-validation-for="Input.Password"
                                          class="text-danger small"></span>

                                </div>

                            </div>

                            <div class="col-12 col-md-6">

                                <div class="form-floating mb-4">

                                    <input asp-for="Input.ConfirmPassword"
                                           class="form-control"
                                           placeholder="Confirm Password" />

                                    <label asp-for="Input.ConfirmPassword"></label>

                                    <span asp-validation-for="Input.ConfirmPassword"
                                          class="text-danger small"></span>

                                </div>

                            </div>

                        </div>

                        <div class="form-floating mb-4">

                            <select asp-for="Input.RoleType"
                                    class="form-select">

                                <option value="Investor">

                                    Investor

                                </option>

                                <option value="Founder">

                                    Startup Founder

                                </option>

                            </select>

                            <label asp-for="Input.RoleType"></label>

                        </div>

                        <button id="registerSubmit"
                                type="submit"
                                class="btn btn-dark btn-lg w-100 rounded-3">

                            Register

                        </button>

                        <div class="text-center mt-4">

                            <p class="mb-0 text-muted">

                                Already have an account?

                                <a asp-page="./Login"
                                   asp-route-returnUrl="@Model.ReturnUrl"
                                   class="fw-semibold text-decoration-none">

                                    Login

                                </a>

                            </p>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}