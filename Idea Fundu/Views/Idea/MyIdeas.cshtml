@model IEnumerable<Idea>

@{
    ViewBag.Title = "My Ideas";
}

<div class="container py-4 py-md-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <h2 class="fw-bold mb-0">
            My Startup Ideas
        </h2>

        <a asp-action="Create"
           class="btn btn-primary rounded-3">

            Add New Idea

        </a>

    </div>

    <div class="row g-4">

        @foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">

                <div class="card border-0 shadow rounded-4 h-100">

                    <div class="card-body d-flex flex-column p-4">

                        <span class="badge bg-dark mb-3 align-self-start">
                            @item.Category
                        </span>

                        <h4 class="fw-bold">
                            @item.Title
                        </h4>

                        <p class="text-muted flex-grow-1">

                            @(item.Description.Length > 100
                                ? item.Description.Substring(0, 100) + "..."
                                : item.Description)

                        </p>

                        <h5 class="text-success fw-bold mb-4">
                            ₹ @item.RequiredFund.ToString("N0")
                        </h5>

                        <div class="d-grid gap-2 d-md-flex">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-primary w-100 rounded-3">

                                Details

                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning w-100 rounded-3">

                                Edit

                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>