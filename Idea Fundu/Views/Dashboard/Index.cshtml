@model DashboardVM

@{
    ViewBag.Title = "Dashboard";
}

<div class="container py-4 py-md-5">

    <!-- PAGE HEADER -->

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 mb-md-5">

        <div class="mb-3 mb-md-0">

            <h2 class="fw-bold mb-2">
                My Dashboard
            </h2>

            <p class="text-muted mb-0">
                Track your startup ideas, investments, and funding activity.
            </p>

        </div>

        <a asp-controller="Idea"
           asp-action="Create"
           class="btn btn-dark rounded-3">

            + Create New Idea

        </a>

    </div>

    <!-- STATS SECTION -->

    <div class="row g-4 mb-5">

        <div class="col-12 col-md-6 col-lg-4">

            <div class="card border-0 shadow rounded-4 h-100">

                <div class="card-body p-4 text-center text-md-start">

                    <div class="mb-3 fs-1">
                        🚀
                    </div>

                    <h6 class="text-muted mb-2">
                        Total Ideas
                    </h6>

                    <h2 class="fw-bold text-primary mb-0">
                        @Model.TotalIdeas
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-12 col-md-6 col-lg-4">

            <div class="card border-0 shadow rounded-4 h-100">

                <div class="card-body p-4 text-center text-md-start">

                    <div class="mb-3 fs-1">
                        💰
                    </div>

                    <h6 class="text-muted mb-2">
                        Total Investments
                    </h6>

                    <h2 class="fw-bold text-success mb-0">
                        @Model.TotalInvestments
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-12 col-md-6 col-lg-4">

            <div class="card border-0 shadow rounded-4 h-100">

                <div class="card-body p-4 text-center text-md-start">

                    <div class="mb-3 fs-1">
                        📈
                    </div>

                    <h6 class="text-muted mb-2">
                        Amount Invested
                    </h6>

                    <h2 class="fw-bold text-dark mb-0">

                        ₹ @Model.TotalAmountInvested.ToString("N0")

                    </h2>

                </div>

            </div>

        </div>

    </div>

    <!-- RECENT IDEAS -->

    <div class="card border-0 shadow rounded-4 mb-5">

        <div class="card-body p-3 p-md-4">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

                <h3 class="fw-bold mb-3 mb-md-0">
                    Recent Ideas
                </h3>

                <a asp-controller="Idea"
                   asp-action="MyIdeas"
                   class="btn btn-outline-primary rounded-3">

                    View All Ideas

                </a>

            </div>

            @if (Model.RecentIdeas.Any())
            {
                <div class="row g-4">

                    @foreach (var item in Model.RecentIdeas)
                    {
                        <div class="col-12 col-md-6">

                            <div class="border rounded-4 p-3 h-100">

                                <span class="badge bg-primary mb-3">
                                    @item.Category
                                </span>

                                <h5 class="fw-bold">
                                    @item.Title
                                </h5>

                                <p class="text-muted small mb-3">

                                    Posted On:
                                    @item.CreatedDate.ToShortDateString()

                                </p>

                                <a asp-controller="Idea"
                                   asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-primary btn-sm rounded-3">

                                    View Details

                                </a>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="alert alert-info rounded-4 mb-0">

                    No ideas created yet.

                </div>
            }

        </div>

    </div>

    <!-- RECENT INVESTMENTS -->

    <div class="card border-0 shadow rounded-4">

        <div class="card-body p-3 p-md-4">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

                <h3 class="fw-bold mb-3 mb-md-0">
                    Recent Investments
                </h3>

                <a asp-controller="Investment"
                   asp-action="MyInvestments"
                   class="btn btn-outline-success rounded-3">

                    View All Investments

                </a>

            </div>

            @if (Model.RecentInvestments.Any())
            {
                <div class="row g-4">

                    @foreach (var item in Model.RecentInvestments)
                    {
                        <div class="col-12 col-md-6">

                            <div class="border rounded-4 p-3 h-100">

                                <h5 class="fw-bold text-success mb-3">

                                    ₹ @item.Amount.ToString("N0")

                                </h5>

                                <p class="mb-2">

                                    <strong>Idea:</strong>
                                    @item.Idea.Title

                                </p>

                                <p class="text-muted small mb-3">

                                    Invested On:
                                    @item.InvestmentDate.ToShortDateString()

                                </p>

                                <a asp-controller="Idea"
                                   asp-action="Details"
                                   asp-route-id="@item.IdeaId"
                                   class="btn btn-outline-success btn-sm rounded-3">

                                    View Idea

                                </a>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="alert alert-info rounded-4 mb-0">

                    No investments made yet.

                </div>
            }

        </div>

    </div>

</div>