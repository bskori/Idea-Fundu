@{
    ViewData["Title"] = "About";
}

<div class="container py-4 py-md-5">

    <div class="card shadow rounded-4 border-0">

        <div class="card-body p-4 p-md-5">

            <div class="text-center text-md-start mb-5">

                <h1 class="fw-bold mb-3">
                    About Idea Fundu
                </h1>

                <p class="fs-6 fs-md-5 text-muted mb-0">

                    Idea Fundu is a startup investment platform built using ASP.NET Core MVC.
                    The platform helps startup founders showcase innovative business ideas and allows investors to discover and support promising startups.

                </p>

            </div>

            <div class="row g-4">

                <div class="col-12 col-md-4">

                    <div class="card shadow-sm border-0 rounded-4 h-100">

                        <div class="card-body text-center p-4">

                            <h1 class="mb-3">🚀</h1>

                            <h5 class="fw-bold">
                                Startup Ideas
                            </h5>

                            <p class="text-muted mb-0">

                                Founders can post innovative startup ideas with funding goals and business details.

                            </p>

                        </div>

                    </div>

                </div>

                <div class="col-12 col-md-4">

                    <div class="card shadow-sm border-0 rounded-4 h-100">

                        <div class="card-body text-center p-4">

                            <h1 class="mb-3">💰</h1>

                            <h5 class="fw-bold">
                                Investor Funding
                            </h5>

                            <p class="text-muted mb-0">

                                Investors can browse startup ideas and invest in promising businesses.

                            </p>

                        </div>

                    </div>

                </div>

                <div class="col-12 col-md-4">

                    <div class="card shadow-sm border-0 rounded-4 h-100">

                        <div class="card-body text-center p-4">

                            <h1 class="mb-3">📈</h1>

                            <h5 class="fw-bold">
                                Progress Tracking
                            </h5>

                            <p class="text-muted mb-0">

                                Track startup progress, updates, investments, and investor discussions.

                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>