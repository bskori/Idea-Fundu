@model IdeaCreateVM

@{
    ViewBag.Title = "Idea Update";
}


<div class="card shadow p-4 rounded-4">
    <h2>Update Idea</h2>

    <form asp-action="Edit" method="post">
        
        <input asp-for="Id" type="hidden"/>

        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RequiredFund" class="form-label"></label>
            <input asp-for="RequiredFund" class="form-control" />
            <span asp-validation-for="RequiredFund" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Category" class="form-label"></label>
            <input asp-for="Category" class="form-control" />
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RiskLevel" class="form-label"></label>
            <input asp-for="RiskLevel" class="form-control" />
            <span asp-validation-for="RiskLevel" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Restrictions" class="form-label"></label>
            <input asp-for="Restrictions" class="form-control" />
            <span asp-validation-for="Restrictions" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                <option value="Pending">Pending</option>

                <option value="Funded">Funded</option>

                <option value="Closed">Closed</option>

            </select>
        </div>


        <div>
            <button class="btn btn-primary" type="submit">Update</button>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}