@model IdeaCreateVM

@{
    ViewBag.Title = "Edit Idea";
}

<div class="container py-4 py-md-5">

    <div class="row justify-content-center">

        <div class="col-12 col-lg-10 col-xl-8">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="bg-dark text-white p-4 p-md-5">

                    <h2 class="fw-bold mb-2 fs-3 fs-md-2">
                        Edit Startup Idea
                    </h2>

                    <p class="mb-0 text-light">
                        Update your startup details and funding information.
                    </p>

                </div>

                <div class="card-body p-3 p-md-5">

                    <form asp-action="Edit"
                          method="post"
                          enctype="multipart/form-data">

                        <input type="hidden" asp-for="Id" />

                        <input type="hidden" asp-for="ImageUrl" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="form-floating mb-4">

                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="Startup Title" />

                            <label asp-for="Title"></label>

                            <span asp-validation-for="Title"
                                  class="text-danger"></span>

                        </div>

                        <div class="form-floating mb-4">

                            <textarea asp-for="Description"
                                      class="form-control"
                                      placeholder="Description"
                                      style="height:140px"></textarea>

                            <label asp-for="Description"></label>

                            <span asp-validation-for="Description"
                                  class="text-danger"></span>

                        </div>

                        <div class="row">

                            <div class="col-12 col-md-6">

                                <div class="form-floating mb-4">

                                    <select asp-for="RiskLevel"
                                            class="form-select">

                                        <option value="">Select Risk Level</option>

                                        <option value="Low">Low</option>

                                        <option value="Medium">Medium</option>

                                        <option value="High">High</option>

                                    </select>

                                    <label asp-for="RiskLevel"></label>

                                    <span asp-validation-for="RiskLevel"
                                          class="text-danger"></span>

                                </div>

                            </div>

                            <div class="col-12 col-md-6">

                                <div class="form-floating mb-4">

                                    <select asp-for="Category"
                                            class="form-select"
                                            asp-items="ViewBag.Categories">

                                        <option value="">Select Category</option>

                                    </select>

                                    <label asp-for="Category"></label>

                                    <span asp-validation-for="Category"
                                          class="text-danger"></span>

                                </div>

                            </div>

                        </div>

                        <div class="form-floating mb-4">

                            <input asp-for="Restrictions"
                                   class="form-control"
                                   placeholder="Restrictions" />

                            <label asp-for="Restrictions"></label>

                            <span asp-validation-for="Restrictions"
                                  class="text-danger"></span>

                        </div>

                        <div class="row">

                            <div class="col-12 col-md-6">

                                <div class="form-floating mb-4">

                                    <input asp-for="RequiredFund"
                                           class="form-control"
                                           placeholder="Required Fund" />

                                    <label asp-for="RequiredFund"></label>

                                    <span asp-validation-for="RequiredFund"
                                          class="text-danger"></span>

                                </div>

                            </div>

                            <div class="col-12 col-md-6">

                                <div class="form-floating mb-4">

                                    <select asp-for="Status"
                                            class="form-select">

                                        <option value="Pending">Pending</option>

                                        <option value="Funded">Funded</option>

                                        <option value="Closed">Closed</option>

                                    </select>

                                    <label asp-for="Status"></label>

                                    <span asp-validation-for="Status"
                                          class="text-danger"></span>

                                </div>

                            </div>

                        </div>

                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mb-4">

                                <label class="form-label fw-semibold mb-3">

                                    Current Startup Image

                                </label>

                                <div>

                                    <img src="/uploads/@Model.ImageUrl"
                                         class="img-fluid rounded-4 shadow-sm w-100"
                                         style="max-height:300px;
                                    object-fit:cover;" />

                                </div>

                            </div>
                        }

                        <div class="mb-4">

                            <label asp-for="ImageFile"
                                   class="form-label fw-semibold">

                                Update Startup Image

                            </label>

                            <input asp-for="ImageFile"
                                   class="form-control form-control-lg rounded-3" />

                        </div>

                        <div class="d-flex flex-column flex-sm-row gap-3">

                            <button type="submit"
                                    class="btn btn-dark btn-lg rounded-3 px-4 w-100">

                                Save Changes

                            </button>

                            <a asp-action="MyIdeas"
                               class="btn btn-outline-secondary btn-lg rounded-3 w-100">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}