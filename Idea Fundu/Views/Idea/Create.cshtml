@model IdeaCreateVM

@{
    ViewBag.Title = "Create Idea";
}

<div class="container py-4 py-md-5">

    <div class="row justify-content-center">

        <div class="col-12 col-lg-10 col-xl-8">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="bg-dark text-white p-4 p-md-5">

                    <h2 class="fw-bold mb-2">
                        Launch Your Startup Idea
                    </h2>

                    <p class="mb-0 text-light">
                        Share your innovative idea and attract investors.
                    </p>

                </div>

                <div class="card-body p-3 p-sm-4 p-md-5">

                    <form asp-action="Create"
                          method="post"
                          enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="form-floating mb-4">

                            <input asp-for="Title"
                                   class="form-control rounded-3"
                                   placeholder="Startup Title" />

                            <label asp-for="Title"></label>

                            <span asp-validation-for="Title"
                                  class="text-danger small"></span>

                        </div>

                        <div class="form-floating mb-4">

                            <textarea asp-for="Description"
                                      class="form-control rounded-3"
                                      placeholder="Description"
                                      style="height:140px"></textarea>

                            <label asp-for="Description"></label>

                            <span asp-validation-for="Description"
                                  class="text-danger small"></span>

                        </div>

                        <div class="row g-3">

                            <div class="col-12 col-md-6">

                                <div class="form-floating">

                                    <select asp-for="RiskLevel"
                                            class="form-select rounded-3">

                                        <option value="">Select Risk Level</option>

                                        <option value="Low">Low</option>

                                        <option value="Medium">Medium</option>

                                        <option value="High">High</option>

                                    </select>

                                    <label asp-for="RiskLevel"></label>

                                    <span asp-validation-for="RiskLevel"
                                          class="text-danger small"></span>

                                </div>

                            </div>

                            <div class="col-12 col-md-6">

                                <div class="form-floating">

                                    <select asp-for="Category"
                                            class="form-select rounded-3"
                                            asp-items="ViewBag.Categories">

                                        <option value="">Select Category</option>

                                    </select>

                                    <label asp-for="Category"></label>

                                    <span asp-validation-for="Category"
                                          class="text-danger small"></span>

                                </div>

                            </div>

                        </div>

                        <div class="form-floating my-4">

                            <input asp-for="Restrictions"
                                   class="form-control rounded-3"
                                   placeholder="Restrictions" />

                            <label asp-for="Restrictions"></label>

                            <span asp-validation-for="Restrictions"
                                  class="text-danger small"></span>

                        </div>

                        <div class="form-floating mb-4">

                            <input asp-for="RequiredFund"
                                   class="form-control rounded-3"
                                   placeholder="Required Fund" />

                            <label asp-for="RequiredFund"></label>

                            <span asp-validation-for="RequiredFund"
                                  class="text-danger small"></span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="ImageFile"
                                   class="form-label fw-semibold">

                                Upload Startup Image

                            </label>

                            <input asp-for="ImageFile"
                                   class="form-control form-control-lg rounded-3" />

                        </div>

                        <div class="d-grid gap-2 d-md-flex">

                            <button type="submit"
                                    class="btn btn-dark btn-lg rounded-3 px-4">

                                Create Idea

                            </button>

                            <a asp-action="MyIdeas"
                               class="btn btn-outline-secondary btn-lg rounded-3">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}