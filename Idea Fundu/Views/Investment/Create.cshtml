@model InvestmentCreateVM

@{
    ViewBag.Title = "Investment Create";
}

<div class="container py-4 py-md-5">

    <div class="row justify-content-center">

        <div class="col-12 col-md-10 col-lg-6">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="bg-success text-white p-4 text-center">

                    <h2 class="fw-bold mb-2">
                        Invest in Startup
                    </h2>

                    <p class="mb-0 small">
                        Support innovative startup ideas
                    </p>

                </div>

                <div class="card-body p-3 p-sm-4 p-md-5">

                    <form method="post">

                        <input asp-for="IdeaId" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="form-floating mb-4">

                            <input asp-for="Amount"
                                   class="form-control rounded-3"
                                   placeholder="Investment Amount" />

                            <label asp-for="Amount"></label>

                            <span asp-validation-for="Amount"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="form-floating mb-4">

                            <textarea asp-for="Suggestions"
                                      class="form-control rounded-3"
                                      placeholder="Suggestions"
                                      style="height:140px"></textarea>

                            <label asp-for="Suggestions"></label>

                            <span asp-validation-for="Suggestions"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="d-grid">

                            <button class="btn btn-success btn-lg rounded-3">

                                Invest Now

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}