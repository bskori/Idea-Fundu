@model IEnumerable<Investment>

@{
    ViewBag.Title = "My Investments";
}

<div class="container py-4 py-md-5">

    <div class="text-center mb-5">

        <h2 class="fw-bold">
            My Investments
        </h2>

        <p class="text-muted">
            Track your startup investments and suggestions
        </p>

    </div>

    @if (Model.Any())
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="card rounded-4 shadow border-0 h-100">

                        <img src="@(string.IsNullOrEmpty(item.Idea.ImageUrl)
                                                                  ? "/uploads/no-image.png"
                                                                  : "/uploads/" + item.Idea.ImageUrl)"
                             class="card-img-top"
                             style="height:220px; object-fit:cover;" />

                        <div class="card-body d-flex flex-column p-4">

                            <span class="badge bg-success mb-3 align-self-start">

                                ₹ @item.Amount.ToString("N0")

                            </span>

                            <h4 class="fw-bold">
                                @item.Idea.Title
                            </h4>

                            <span class="badge bg-dark mb-3 align-self-start">
                                @item.Idea.Category
                            </span>

                            <p class="text-muted flex-grow-1">

                                @(string.IsNullOrEmpty(item.Suggestions)
                                    ? "No suggestions added."
                                    : item.Suggestions)

                            </p>

                            <p class="small text-muted mb-4">

                                Invested On:
                                @item.InvestmentDate.ToShortDateString()

                            </p>

                            <a asp-action="Details"
                               asp-controller="Idea"
                               asp-route-id="@item.IdeaId"
                               class="btn btn-outline-primary rounded-3 w-100">

                                View Idea

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body text-center p-4 p-md-5">

                <h4 class="fw-bold mb-3">
                    No Investments Yet
                </h4>

                <p class="text-muted mb-4">
                    Explore startup ideas and begin investing.
                </p>

                <a asp-controller="Idea"
                   asp-action="Index"
                   class="btn btn-dark rounded-3 px-4">

                    Explore Ideas

                </a>

            </div>

        </div>
    }

</div>