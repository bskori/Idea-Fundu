@model Idea
@using System.Security.Claims

@{
    ViewBag.Title = "Idea Details";

    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    bool isOwner = currentUserId == Model.UserId;
}

<div class="container py-4 py-md-5">

    <div class="row g-4">

        <div class="col-12 col-lg-8">

            <div class="card border-0 shadow rounded-4 mb-4 overflow-hidden">

                <img src="@(string.IsNullOrEmpty(Model.ImageUrl)
                                                   ? "/uploads/no-image.png"
                                                   : "/uploads/" + Model.ImageUrl)"
                     class="img-fluid"
                     style="height:400px;
                width:100%;
                object-fit:cover;" />

            </div>

            <div class="card border-0 shadow rounded-4 mb-4">

                <div class="card-body p-4 p-md-5">

                    <div class="d-flex flex-wrap gap-2 mb-3">

                        <span class="badge bg-primary">
                            @Model.Category
                        </span>

                        <span class="badge
                            @(Model.Status == "Funded" ? "bg-success" :
                                Model.Status == "Closed" ? "bg-danger" :
                                "bg-warning text-dark")">

                            @Model.Status

                        </span>

                    </div>

                    <h1 class="fw-bold mb-4 fs-2 fs-md-1">
                        @Model.Title
                    </h1>

                    <p class="text-muted fs-6 fs-md-5 mb-0">
                        @Model.Description
                    </p>

                </div>

            </div>

            <div class="card border-0 shadow rounded-4 mb-4">

                <div class="card-body p-4">

                    <h3 class="fw-bold mb-3">
                        Risk Analysis
                    </h3>

                    <p class="mb-0">
                        @(Model.RiskLevel ?? "No risk analysis available.")
                    </p>

                </div>

            </div>

            <div class="card border-0 shadow rounded-4 mb-4">

                <div class="card-body p-4">

                    <h3 class="fw-bold mb-3">
                        Investment Restrictions
                    </h3>

                    <p class="mb-0">
                        @(Model.Restrictions ?? "No restrictions added.")
                    </p>

                </div>

            </div>

            <div class="card border-0 shadow rounded-4">

                <div class="card-body p-4">

                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

                        <h3 class="fw-bold mb-0">
                            Startup Updates
                        </h3>

                        @if (User.Identity.IsAuthenticated && isOwner)
                        {
                            <a asp-action="Create"
                               asp-controller="StartupUpdate"
                               asp-route-ideaId="@Model.Id"
                               class="btn btn-primary rounded-3">

                                Add Update

                            </a>
                        }

                    </div>

                    @if (ViewBag.Updates.Count > 0)
                    {
                        @foreach (var item in ViewBag.Updates)
                        {
                            <div class="border rounded-4 p-3 mb-3">

                                <h5 class="fw-bold">
                                    @item.Title
                                </h5>

                                <p class="mb-2">
                                    @item.Description
                                </p>

                                <small class="text-muted">

                                    Posted On:
                                    @item.CreatedDate.ToShortDateString()

                                </small>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info rounded-4 mb-0">

                            No startup updates available.

                        </div>
                    }

                </div>

            </div>

            @if (User.Identity.IsAuthenticated && !isOwner)
            {
                <div class="card border-0 shadow rounded-4 mt-4">

                    <div class="card-body p-4">

                        <h3 class="fw-bold mb-4">

                            Investor Discussions

                        </h3>

                        <form asp-action="Create"
                              asp-controller="Comment"
                              method="post">

                            <input type="hidden"
                                   name="ideaId"
                                   value="@Model.Id" />

                            <div class="mb-3">

                                <textarea name="Message"
                                          class="form-control rounded-3"
                                          rows="4"
                                          placeholder="Write your comment..."></textarea>

                            </div>

                            <button class="btn btn-primary rounded-3">

                                Post Comment

                            </button>

                        </form>

                        <hr />

                        @if (ViewBag.Comments != null && ViewBag.Comments.Count > 0)
                        {
                            @foreach (var item in ViewBag.Comments)
                            {
                                <div class="border rounded-4 p-3 mb-3">

                                    <div class="d-flex flex-column flex-md-row justify-content-between gap-2">

                                        <h6 class="fw-bold mb-0">

                                            @item.User.FullName

                                        </h6>

                                        <small class="text-muted">

                                            @item.CreatedDate.ToShortDateString()

                                        </small>

                                    </div>

                                    <p class="mt-3 mb-0">

                                        @item.Message

                                    </p>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-info rounded-4 mb-0">

                                No discussions available yet.

                            </div>
                        }

                    </div>

                </div>
            }

        </div>

        <div class="col-12 col-lg-4">

            <div class="card border-0 shadow rounded-4 sticky-lg-top">

                <div class="card-body p-4">

                    <h3 class="fw-bold text-success mb-3">
                        ₹ @Model.RequiredFund.ToString("N0")
                    </h3>

                    <p class="text-muted mb-3">
                        Funding Goal
                    </p>

                    <p class="small text-muted">
                        Investors can support this startup until target funding is achieved.
                    </p>

                    <p class="text-muted">
                        Posted on @Model.CreatedDate.ToShortDateString()
                    </p>

                    <hr />

                    <div class="mb-4">

                        <h5 class="text-success fw-bold">
                            ₹ @ViewBag.TotalInvestment.ToString("N0")
                        </h5>

                        <p class="text-muted mb-0">
                            Total Investment Raised
                        </p>

                    </div>

                    <div class="mb-4">

                        <label class="fw-bold mb-2">

                            Funding Progress

                        </label>

                        <div class="progress"
                             style="height:25px">

                            <div class="progress-bar bg-success"
                                 style="width:@ViewBag.Progress%">

                                @Math.Round(ViewBag.Progress, 0)%

                            </div>

                        </div>

                    </div>

                    <div class="mb-4">

                        <p class="mb-0">

                            <strong>Remaining Amount:</strong>
                            ₹ @ViewBag.RemainingAmount.ToString("N0")

                        </p>

                    </div>

                    @if (User.Identity.IsAuthenticated && !isOwner)
                    {
                        <div class="d-grid">

                            <a asp-action="Create"
                               asp-controller="Investment"
                               asp-route-ideaId="@Model.Id"
                               class="btn btn-success btn-lg rounded-3">

                                Invest Now

                            </a>

                        </div>
                    }

                    <div class="d-grid mt-3">

                        @if (User.Identity.IsAuthenticated && !isOwner)
                        {
                            <a asp-action="Index"
                               class="btn btn-outline-dark rounded-3">

                                Back to Ideas

                            </a>
                        }
                        else
                        {
                            <a asp-action="MyIdeas"
                               class="btn btn-outline-dark rounded-3">

                                Back to Ideas

                            </a>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>