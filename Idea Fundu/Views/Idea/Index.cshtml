@using System.Security.Claims
@model IEnumerable<Idea>
@using Microsoft.AspNetCore.Identity;

@inject SignInManager<ApplicationUser> SignInManager;
@inject UserManager<ApplicationUser> UserManager;

@{
    ViewBag.Title = "Idea List";
    var currentUser = await UserManager.GetUserAsync(User);
}
<div class="container py-4">

    <form method="get">

        <div class="row g-3 align-items-end">

            <div class="col-12 col-lg-5">

                <label class="form-label fw-semibold">
                    Search
                </label>

                <input type="text"
                       name="searchTerm"
                       value="@ViewBag.SearchTerm"
                       class="form-control rounded-3"
                       placeholder="Search startup ideas..." />

            </div>

            <div class="col-12 col-md-6 col-lg-4">

                <label class="form-label fw-semibold">
                    Category
                </label>

                <select name="category"
                        class="form-select rounded-3">

                    <option value="">All Categories</option>

                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category"
                                selected="@(ViewBag.Category == category)">
                            @category
                        </option>
                    }

                </select>

            </div>

            <div class="col-12 col-md-6 col-lg-3">

                <button class="btn btn-dark w-100 rounded-3">

                    Search

                </button>

            </div>

        </div>

    </form>

</div>

<div class="container">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <h1 class="fw-bold mb-0">
            Explore Ideas
        </h1>

        @if (SignInManager.IsSignedIn(User) && currentUser?.RoleType != "Investor")
        {
            <a asp-action="Create"
               class="btn btn-primary rounded-3">

                Add New Idea

            </a>
        }

    </div>

        @if (Model.Any())
    {
        <div class="row">

            @foreach (var idea in Model)
            {
                <div class="col-12 col-md-6 col-lg-4 mb-4">

                    <div class="card shadow-sm h-100 border-0 rounded-4">

                        <img src="@(string.IsNullOrEmpty(idea.ImageUrl)
                                     ? "/uploads/no-image.png"
                                     : "/uploads/" + idea.ImageUrl)"
                             class="card-img-top"
                             style="height:220px; object-fit:cover;"
                             loading="lazy" />


                        <div class="card-body">


                            <h4 class="fw-bold">@idea.Title</h4>

                            <span class="badge bg-primary mb-3">
                                @idea.Category
                            </span>

                            <span class="badge
                                @(idea.Status == "Funded" ? "bg-success" :
                                        idea.Status == "Closed" ? "bg-danger" :
                                      "bg-warning text-dark")">

                                @idea.Status

                            </span>

                            <p>
                                @(idea.Description.Length > 120 ? idea.Description.Substring(0, 120) + "..." : idea.Description)
                            </p>

                            <h5 class="text-success">
                                ₹ @idea.RequiredFund.ToString("N0")
                            </h5>

                        </div>

                        <div class="card-footer bg-white border-0">
                            <a asp-action="Details" asp-route-id="@idea.Id" class="btn btn-outline-primary w-100">View Details</a>

                            @if(User.Identity.IsAuthenticated && idea.UserId == User.FindFirstValue(ClaimTypes.NameIdentifier))
                            {
                                <div class="d-grid gap-2 d-md-flex mt-2">

                                    <a asp-action="Edit" asp-route-id="@idea.Id" class="btn btn-warning w-50">Edit</a>

                                    <a asp-action="Delete" asp-route-id="@idea.Id" class="btn btn-danger w-50">Delete</a>

                                </div>
                            }
                        </div>

                    </div>

                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info rounded-4 text-center p-4">

            <h5 class="fw-bold">
                No startup ideas found.
            </h5>

            <p class="mb-0">
                Try changing search term or category.
            </p>
        </div>
    }


</div>

<div class="d-flex justify-content-center mt-4 mb-4 overflow-auto">

    <ul class="pagination">

        @if (ViewBag.CurrentPage > 1)
        {
            <li class="page-item">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-searchTerm="@ViewBag.SearchTerm"
                   asp-route-category="@ViewBag.Category">

                    Previous

                </a>

            </li>
        }

        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@i"
                   asp-route-searchTerm="@ViewBag.SearchTerm"
                   asp-route-category="@ViewBag.Category">

                    @i

                </a>

            </li>
        }

        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
        {
            <li class="page-item">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-searchTerm="@ViewBag.SearchTerm"
                   asp-route-category="@ViewBag.Category">

                    Next

                </a>

            </li>
        }

    </ul>

</div>