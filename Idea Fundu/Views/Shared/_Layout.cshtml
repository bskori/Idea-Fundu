@using Microsoft.AspNetCore.Identity
@using Idea_Fundu.Models
@inject SignInManager<ApplicationUser> SignInManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Idea_Fundu</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Idea_Fundu.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm sticky-top">
            <div class="container">

                <a class="navbar-brand fw-bold"  asp-controller="Home" asp-action="Index">Idea Fundu</a>


                <button class="navbar-toggler" 
                type="button"
                data-bs-toggle="collapse" 
                data-bs-target="#navbarContent" 
                >

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="collapse navbar-collapse" id="navbarContent">

                    <ul class="navbar-nav me-auto">

                        

                        <li class="nav-item">
                            <a class="nav-link " 
                            asp-controller="Home" 
                            asp-action="Index">
                            Home
                        </a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link" 
                            asp-controller="Idea" 
                            asp-action="Index">
                            Explore Ideas
                        </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-action="MyInvestments"
                               asp-controller="Investment">

                                My Investments

                            </a>
                        </li>

                        @if (SignInManager.IsSignedIn(User))
                            {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-action="Index"
                                   asp-controller="Dashboard">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Idea"
                                   asp-action="Create">
                                    Add Idea
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Idea"
                                   asp-action="MyIdeas">
                                    My Ideas
                                </a>
                            </li>
                            }
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="About">
                                About
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Contact">
                                Contact
                            </a>
                        </li>


                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="flex-grow-1 py-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white text-center py-3  mt-3">
        <div class="container text-center">
            <p class="mb-1 fw-bold">
                Idea Fundu
            </p>

            <p class="mb-0">
                Connecting startups with investors.
            </p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
