@{
    ViewData["Title"] = "About";
}

<div class="container mt-5">

    <div class="card shadow rounded-4 border-0">

        <div class="card-body p-5">

            <h1 class="fw-bold mb-4">
                About Idea Fundu
            </h1>

            <p class="fs-5 text-muted">

                Idea Fundu is a startup investment platform built using ASP.NET Core MVC.

                The platform helps startup founders showcase innovative business ideas and allows investors to discover and support promising startups.

            </p>

            <hr />

            <div class="row mt-4">

                <div class="col-md-4">

                    <div class="card shadow-sm border-0 rounded-4 h-100">

                        <div class="card-body text-center">

                            <h3>
                                🚀
                            </h3>

                            <h5 class="fw-bold">
                                Startup Ideas
                            </h5>

                            <p class="text-muted">

                                Founders can post innovative startup ideas with funding goals and business details.

                            </p>

                        </div>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="card shadow-sm border-0 rounded-4 h-100">

                        <div class="card-body text-center">

                            <h3>
                                💰
                            </h3>

                            <h5 class="fw-bold">
                                Investor Funding
                            </h5>

                            <p class="text-muted">

                                Investors can browse startup ideas and invest in promising businesses.

                            </p>

                        </div>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="card shadow-sm border-0 rounded-4 h-100">

                        <div class="card-body text-center">

                            <h3>
                                📈
                            </h3>

                            <h5 class="fw-bold">
                                Progress Tracking
                            </h5>

                            <p class="text-muted">

                                Track startup progress, updates, investments, and investor discussions.

                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>